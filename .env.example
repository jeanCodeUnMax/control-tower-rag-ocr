# Stockage local des projets
CONTROL_TOWER_HOME=.control_tower

# Clé optionnelle pour protéger une future API exposée
CONTROL_TOWER_API_KEY=

# Fournisseurs multimodaux optionnels
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=

# Ollama local ou cloud
OLLAMA_BASE_URL=http://localhost:11434/v1

# Journalisation
CONTROL_TOWER_LOG_LEVEL=INFO
